# ---- Nubia NX809J (SM8850 / kaanapali) bring-up config fragment ----
# Appended to arm64 defconfig, then resolved via `make olddefconfig`.
# Enable the bits needed to reach a console + display + UFS + USB + GPU.

# --- SoC / platform (gates all kaanapali SoC support + DTBs) ---
CONFIG_ARCH_QCOM=y

# --- Serial console (uart7) ---
CONFIG_TTY=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_QCOM=y
CONFIG_SERIAL_QCOM_CONSOLE=y

# --- Initramfs + early userspace ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- UFS storage ---
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# --- USB (peripheral + adbd/fastboot) ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_ADB=y

# --- Display (DRM/MSM + NT37801 panel) ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_PANEL_NOVATEK_NT37801=y
CONFIG_PHY_QCOM_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- GPU (Adreno 840 via drm/msm/adreno) ---
CONFIG_DRM_MSM_ADRENO=y

# --- IOMMU (adreno_smmu = arm,mmu-500) ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y

# --- Qualcomm SoC glue ---
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_PDC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_KAANAPALI=y
CONFIG_COMMON_CLK_QCOM=y

# --- Filesystems (for real rootfs later) ---
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
