# Nubia Red Magic 11S Pro+ (NX809J) U-Boot environment.
#
# The panel is the ONLY reachable console on this board: there are no UART
# pads and this build has no USB gadget yet. stdout/stderr therefore go to the
# video console, which draws into the splash buffer ABL left the DPU scanning
# (0xfc800000, 0x2b00000 bytes) - so it works with no display driver at all.
# stdin keeps the always-registered "serial" stdio stub so console setup has an
# input device to attach; it never produces input.
stdin=serial
stdout=vidconsole
stderr=vidconsole

# bootdelay is deliberately NOT set here: the defconfig compiles in
# CONFIG_BOOTDELAY=-2, which runs bootcmd immediately with no countdown and no
# way to abort. There is nothing to type on anyway.
#
# Load addresses (kernel_addr_r, ramdisk_addr_r, fdt_addr_r, scriptaddr) are
# deliberately NOT set either: mach-snapdragon's board_late_init() allocates
# them at runtime out of ABL's real memory map via LMB (honouring
# /reserved-memory, including the splash carve-out) and its env_set_hex() calls
# run after initr_env, so anything set here would be overwritten.

# Bring-up bootcmd: stay in U-Boot and dump everything useful onto the panel so
# we can see how far the platform actually comes up - ABL's RAM map, the
# clocks, and what UFS LUNs/GPTs the storage stack can find. Every command is
# independent, so a failure prints an error and the dump keeps going.
bootcmd=echo; \
echo "=== Nubia NX809J (SM8850 / kaanapali) - U-Boot bring-up ==="; \
echo; \
echo "--- board info / DRAM map from ABL ---"; \
bdinfo; \
echo; \
echo "--- clocks ---"; \
clk dump; \
echo; \
echo "--- storage ---"; \
bootdev hunt scsi; \
part list scsi 0; \
part list scsi 1; \
part list scsi 2; \
part list scsi 3; \
part list scsi 4; \
echo; \
echo "--- environment ---"; \
printenv; \
echo; \
echo "=== U-Boot console is alive on the panel ==="; \
echo "Next: boot a kernel from a partition via sysboot/extlinux."
