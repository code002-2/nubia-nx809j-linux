# Nubia Red Magic 11S Pro+ (NX809J) U-Boot environment.
#
# The panel is the ONLY console on this board: no UART pads, no USB gadget in
# this build. stdout/stderr go to the video console, which draws into the
# splash buffer ABL left the DPU scanning (0xfc800000, 0x2b00000 bytes), so it
# works with no display driver at all. stdin keeps the always-registered
# "serial" stdio stub so console setup has an input device; it never produces
# input, which is why bootcmd is written as a self-contained script rather than
# something you interact with.
#
# NOTE the shell is the SIMPLE parser, not hush (CONFIG_HUSH_PARSER is off in
# qcom_nx809j_defconfig, and CONFIG_CMD_TEST/LS/FAT are off too): there is no
# `if`, no `test`, no `ls`, no `fatls`. A bootcmd can only be a linear list,
# and fallbacks work by letting a failing command print its error and fall
# through to the next one. Keep that in mind before adding anything clever.
stdin=serial
stdout=vidconsole
stderr=vidconsole

# bootdelay is deliberately NOT set: the defconfig compiles in
# CONFIG_BOOTDELAY=-2, which runs bootcmd immediately with no countdown and no
# way to abort. There is nothing to type on anyway.
#
# Load addresses are deliberately NOT set either: mach-snapdragon's
# board_late_init() allocates scriptaddr/kernel_addr_r/ramdisk_addr_r/
# fdt_addr_r at runtime out of ABL's real memory map via LMB (honouring
# /reserved-memory, including the splash carve-out), and its env_set_hex()
# calls run after initr_env - so anything written here would be overwritten.

# Fast path: boot Linux off the boot_b staging FAT.
#
# boot_b is the inactive A/B slot (100663296 bytes) - nothing ever boots from
# it, so it is free real estate. It is filled from the Android side with a FAT
# filesystem holding Image.gz, the board DTB, the initramfs and
# /extlinux/extlinux.conf (see the "Package boot_b staging FAT" step in
# .github/workflows/build.yml).
#
# The partition number is looked up by PARTLABEL rather than hardcoded: on the
# Android side boot_b is /dev/block/sde55, i.e. LUN 4 partition 55, and U-Boot
# numbers UFS LUNs in the same order as the kernel numbers sdX - so this is
# expected to report 55 on scsi 4, and if it does not, the line says so.
#
# On success sysboot does not return. Everything after it is the failure path:
# the same attempt on the other LUNs, then an explicit "nothing booted" marker
# instead of a bare dead prompt.
bootcmd=echo; \
echo "=== NX809J: U-Boot -> mainline Linux from the boot_b staging FAT ==="; \
bootdev hunt scsi; \
part number scsi 4 boot_b pn; \
echo "  boot_b on scsi 4 = partition [${pn}]  (expected 55)"; \
echo "  scriptaddr=${scriptaddr} kernel_addr_r=${kernel_addr_r} fdt_addr_r=${fdt_addr_r}"; \
echo "  --- sysboot ---"; \
sysboot scsi 4:${pn} fat ${scriptaddr} /extlinux/extlinux.conf; \
echo "  scsi4 returned - trying the other LUNs"; \
part number scsi 0 boot_b q0; sysboot scsi 0:${q0} fat ${scriptaddr} /extlinux/extlinux.conf; \
part number scsi 1 boot_b q1; sysboot scsi 1:${q1} fat ${scriptaddr} /extlinux/extlinux.conf; \
part number scsi 2 boot_b q2; sysboot scsi 2:${q2} fat ${scriptaddr} /extlinux/extlinux.conf; \
part number scsi 3 boot_b q3; sysboot scsi 3:${q3} fat ${scriptaddr} /extlinux/extlinux.conf; \
part number scsi 5 boot_b q5; sysboot scsi 5:${q5} fat ${scriptaddr} /extlinux/extlinux.conf; \
echo; \
echo "=== NOTHING BOOTED: every candidate returned. ==="; \
echo "  * is boot_b filled with the staging FAT?  (adb dd of bootb.img)"; \
echo "  * does it contain /extlinux/extlinux.conf, Image.gz and the .dtb?"; \
echo "  * did any sysboot line above report a filesystem or file error?"
